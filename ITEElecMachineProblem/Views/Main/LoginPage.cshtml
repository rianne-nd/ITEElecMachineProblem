@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container" style="margin-top: 40px;">
    <div class="row">
        <div class="col s12 m6 offset-m3">
            <div class="card">
                <div class="card-content">
                    <span class="card-title center-align">Login</span>

                    <div class="input-field">
                        <input id="txtLoginUsername" type="text" ng-model="loginUsername" placeholder="Username" />
                    </div>
                    <div class="input-field">
                        <input id="txtLoginPassword" type="password" ng-model="loginPassword" placeholder="Password" />
                    </div>

                    <div class="center-align">
                        <a class="btn blue darken-3" ng-click="redirectFunc('/Main/Index')">Login</a>
                        <a class="btn grey" ng-click="clearLoginFunc()">Clear</a>
                    </div>

                    <p class="center-align">Don't have an account? <a href="" ng-click="redirectFunc('/Main/RegistrationPage')">Register here</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
