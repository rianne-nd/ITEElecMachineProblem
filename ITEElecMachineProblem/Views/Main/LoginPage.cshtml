@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="dot-grid py-12 px-4 md:px-8 relative overflow-hidden">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-center gap-10 md:gap-16 relative z-10">

        <!-- Decorative stickers -->
        <div class="absolute top-0 left-4 opacity-15 -rotate-12 pointer-events-none hidden md:block">
            <span class="material-symbols-outlined text-7xl text-primary">badge</span>
        </div>
        <div class="absolute bottom-0 right-4 opacity-15 rotate-12 pointer-events-none hidden md:block">
            <span class="material-symbols-outlined text-8xl text-secondary">groups</span>
        </div>

        <!-- Left: Scrapbook panel -->
        <div class="relative group rotate-[-2deg] transition-transform hover:rotate-0 duration-500">
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-32 h-8 bg-secondary-container/60 washi-tape z-20 rounded-sm"></div>

            <div class="bg-surface-container-lowest p-4 pb-10 shadow-2xl rounded-sm">
                <div class="aspect-square w-64 md:w-72 overflow-hidden rounded-sm relative bg-gradient-to-br from-secondary-container/70 to-primary-fixed/60 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[7rem] text-primary/70">badge</span>
                    <div class="absolute inset-0 border-2 border-dashed border-secondary/30 pointer-events-none"></div>
                </div>
                <div class="mt-6 text-center">
                    <p class="text-on-surface-variant font-medium tracking-tight text-lg italic opacity-70">"Welcome back, employee"</p>
                </div>
            </div>

            <div class="absolute -bottom-4 -right-4 w-16 h-16 bg-white rounded-full shadow-md flex items-center justify-center rotate-12 border-4 border-surface-container">
                <span class="material-symbols-outlined text-primary text-3xl">work</span>
            </div>
        </div>

        <!-- Right: Login card -->
        <div class="relative w-full max-w-md rotate-[1deg] transition-transform hover:rotate-0 duration-500">
            <div class="absolute -top-6 right-12 w-8 h-16 border-4 border-outline-variant rounded-full opacity-40 z-20"></div>

            <div class="bg-surface p-8 md:p-10 shadow-xl rounded-xl relative overflow-hidden border-4 border-dashed border-primary/40">
                <div class="mb-10 text-center">
                    <h1 class="text-4xl font-extrabold text-primary tracking-tighter mb-2">EMS Portal</h1>
                    <p class="text-on-surface-variant text-sm font-medium tracking-wide uppercase opacity-60">Welcome back, employee</p>
                </div>

                <form class="space-y-6" ng-submit="$event.preventDefault()">
                    <div class="space-y-2">
                        <label class="block text-xs font-bold tracking-widest text-primary uppercase ml-1" for="login_username">Username</label>
                        <input class="browser-default w-full bg-surface-container-high border-none rounded-xl px-4 py-3 focus:ring-2 focus:ring-secondary/50 transition-all text-on-surface placeholder:text-outline" id="login_username" type="text" ng-model="loginUsername" placeholder="juan.delacruz" />
                    </div>

                    <div class="space-y-2">
                        <div class="flex justify-between items-center">
                            <label class="block text-xs font-bold tracking-widest text-primary uppercase ml-1" for="login_password">Password</label>
                            <a class="text-xs font-semibold text-secondary hover:underline underline-offset-4 cursor-pointer">Forgot?</a>
                        </div>
                        <input class="browser-default w-full bg-surface-container-high border-none rounded-xl px-4 py-3 focus:ring-2 focus:ring-secondary/50 transition-all text-on-surface placeholder:text-outline" id="login_password" type="password" ng-model="loginPassword" placeholder="********" />
                    </div>

                    <div class="flex items-center space-x-3 ml-1">
                        <input class="rounded-lg bg-surface-container-high border-none text-primary focus:ring-0 w-5 h-5 cursor-pointer" id="remember" type="checkbox" />
                        <label class="text-sm text-on-surface-variant font-medium" for="remember">Keep me logged in</label>
                    </div>

                    <div class="space-y-3">
                        <button class="w-full bg-gradient-to-br from-primary to-primary-container text-white font-bold py-4 rounded-full shadow-lg hover:shadow-primary/20 transform active:scale-95 transition-all text-sm uppercase tracking-widest" type="button" ng-click="redirectFunc('/Main/Index')">
                            Sign In
                        </button>
                        <button class="w-full py-3 px-6 bg-transparent text-primary font-bold rounded-full border-2 border-dashed border-primary/40 hover:bg-primary/5 transition-all active:scale-[0.98] text-sm uppercase tracking-widest" type="button" ng-click="clearLoginFunc()">
                            Clear
                        </button>
                    </div>
                </form>

                <div class="mt-8 pt-8 border-t border-dashed border-outline-variant/30 text-center">
                    <p class="text-on-surface-variant text-sm font-medium">
                        Don't have an account?
                        <a class="text-primary font-bold hover:text-secondary transition-colors underline decoration-secondary-container decoration-4 underline-offset-4 cursor-pointer" ng-click="redirectFunc('/Main/RegistrationPage')">Register here</a>
                    </p>
                </div>

                <div class="absolute -bottom-2 -left-4 px-4 py-1 bg-secondary text-white text-[10px] font-bold tracking-widest uppercase -rotate-3 shadow-sm rounded-sm">
                    Employee Self-Service
                </div>
            </div>

            <div class="absolute -bottom-3 -left-10 w-24 h-6 bg-primary-container/40 washi-tape -rotate-12 z-0"></div>
        </div>
    </div>
</div>
