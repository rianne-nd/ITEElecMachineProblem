                        <span class="material-symbols-outlined">call</span>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-on-surface-variant">Phone</p>
                        <p class="text-on-surface font-semibold">09763615092</p>
                    </div>
