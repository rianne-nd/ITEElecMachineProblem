                <a class="flex items-center gap-4 p-5 rounded-2xl bg-surface-container-low border-2 border-dashed border-outline-variant/30 hover:border-secondary transition-colors" href="mailto:edriannejohn.puno.cics@ust.edu.ph">
                    <div class="w-12 h-12 rounded-xl bg-tertiary-fixed flex items-center justify-center text-on-tertiary-fixed-variant">
                        <span class="material-symbols-outlined">mail</span>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-on-surface-variant">Email</p>
                        <p class="text-on-surface font-semibold">edriannejohn.puno.cics@ust.edu.ph</p>
                    </div>
                </a>

                <a class="flex items-center gap-4 p-5 rounded-2xl bg-surface-container-low border-2 border-dashed border-outline-variant/30 hover:border-secondary transition-colors" href="tel:+639763615092">
