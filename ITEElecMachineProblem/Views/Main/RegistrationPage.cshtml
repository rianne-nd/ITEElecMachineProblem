@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container" style="margin-top: 30px;">

    <h4 class="blue-text text-darken-3">Registration Page</h4>

    <div class="card">
        <div class="card-content">
            <div class="row">
                <div class="input-field col s12 m6">
                    <input id="emp_id" type="text" ng-model="empID" placeholder="Employee ID" />
                    <span class="helper-text">Required. numbers only.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="first_name" type="text" ng-model="firstName" placeholder="First Name" />
                    <span class="helper-text">Required.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="middle_name" type="text" ng-model="middleName" placeholder="Middle Name" />
                    <span class="helper-text">Optional.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="last_name" type="text" ng-model="lastName" placeholder="Last Name" />
                    <span class="helper-text">Required.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="username" type="text" ng-model="username" placeholder="Username" />
                    <span class="helper-text">Required. must be unique.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="email" type="email" ng-model="email" placeholder="Email" />
                    <span class="helper-text">Required. enter a valid email address.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="password" type="password" ng-model="password" placeholder="Password" />
                    <span class="helper-text">Required. 8+ characters with upper/lowercase, a number, and a special character.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="confirm_password" type="password" ng-model="confirmPassword" placeholder="Confirm Password" />
                    <span class="helper-text">Required. must match the password.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="contact_number" type="text" ng-model="contactNumber" placeholder="Contact Number" />
                    <span class="helper-text">Required. exactly 11 digits.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="position" type="text" ng-model="position" placeholder="Position" />
                    <span class="helper-text">Required.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="department" type="text" ng-model="department" placeholder="Department" />
                    <span class="helper-text">Required.</span>
                </div>
            </div>

            <div class="row">
                <div class="col s12">
                    <button class="btn blue darken-3" ng-click="registrationFunc()">Register</button>
                    <button class="btn grey" ng-click="updateFunc()">Update</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-content">
            <span class="card-title">Registered Employees</span>
            <table class="striped highlight">
                <thead>
                    <tr>
                        <th>Employee ID</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Position</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="udata in userArray">
                        <td>{{udata.EmpID}}</td>
                        <td>{{udata.FName}}</td>
                        <td>{{udata.LName}}</td>
                        <td>{{udata.Username}}</td>
                        <td>{{udata.Email}}</td>
                        <td>{{udata.Position}}</td>
                        <td>
                            <button class="btn-small blue darken-3" ng-click="editFunc($index)">Edit</button>
                            <button class="btn-small red" ng-click="deleteFunc($index)">Delete</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>
