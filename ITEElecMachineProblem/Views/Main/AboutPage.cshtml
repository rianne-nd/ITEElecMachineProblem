@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container" style="margin-top: 30px;">

    <h4 class="blue-text text-darken-3">About EMS Portal</h4>

    <p>
        EMS Portal is an Employee Management System built with ASP.NET MVC and AngularJS.
        It lets you register, view, update, and delete employee records, with input validation handled on the client.
    </p>

    <h5>Features</h5>
    <ul>
        <li>Register new employees</li>
        <li>Edit and update records</li>
        <li>Delete records</li>
        <li>Input validation with SweetAlert2 feedback</li>
        <li>Live, dynamically bound data table</li>
    </ul>

    <h5>Tech Stack</h5>
    <p>ASP.NET MVC 5 with C#, and AngularJS with Materialize CSS and SweetAlert2.</p>

</div>
