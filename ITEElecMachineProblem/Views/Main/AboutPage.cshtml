@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="dot-grid py-12 px-4 md:px-8 relative overflow-hidden">
    <div class="absolute -top-10 -right-10 w-56 h-56 rounded-full bg-secondary-container/30 blur-3xl pointer-events-none"></div>

    <div class="max-w-4xl mx-auto relative z-10">

        <div class="bg-surface-container-lowest rounded-3xl shadow-xl border-2 border-dashed border-outline-variant/30 p-8 md:p-12">

            <div class="flex items-center gap-3">
                <div class="w-14 h-14 rounded-2xl bg-tertiary-fixed flex items-center justify-center text-on-tertiary-fixed-variant">
                    <span class="material-symbols-outlined text-3xl">info</span>
                </div>
                <div>
                    <h1 class="text-3xl font-headline font-extrabold text-primary tracking-tight">About EMS Portal</h1>
                    <p class="text-on-surface-variant text-sm">Employee Management System</p>
                </div>
            </div>

            <p class="text-on-surface-variant mt-8 leading-relaxed">
                EMS Portal is an Employee Management System built with ASP.NET MVC and AngularJS.
                It lets you register, view, update, and delete employee records, with input validation handled on the client.
            </p>

            <!-- Features -->
            <h2 class="text-xl font-headline font-bold text-primary mt-10 mb-4">Features</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="flex items-start gap-3 p-4 rounded-2xl bg-surface-container-low border-2 border-dashed border-outline-variant/30">
                    <span class="material-symbols-outlined text-primary">person_add</span>
                    <span class="text-sm text-on-surface">Register new employees</span>
                </div>
                <div class="flex items-start gap-3 p-4 rounded-2xl bg-surface-container-low border-2 border-dashed border-outline-variant/30">
                    <span class="material-symbols-outlined text-primary">edit</span>
                    <span class="text-sm text-on-surface">Edit and update records</span>
                </div>
                <div class="flex items-start gap-3 p-4 rounded-2xl bg-surface-container-low border-2 border-dashed border-outline-variant/30">
                    <span class="material-symbols-outlined text-primary">delete</span>
                    <span class="text-sm text-on-surface">Delete records</span>
                </div>
                <div class="flex items-start gap-3 p-4 rounded-2xl bg-surface-container-low border-2 border-dashed border-outline-variant/30">
                    <span class="material-symbols-outlined text-primary">verified_user</span>
                    <span class="text-sm text-on-surface">Input validation with SweetAlert2 feedback</span>
                </div>
                <div class="flex items-start gap-3 p-4 rounded-2xl bg-surface-container-low border-2 border-dashed border-outline-variant/30 sm:col-span-2">
                    <span class="material-symbols-outlined text-primary">table_view</span>
                    <span class="text-sm text-on-surface">Live, dynamically bound data table</span>
                </div>
            </div>

            <!-- Tech Stack -->
            <h2 class="text-xl font-headline font-bold text-primary mt-10 mb-4">Tech Stack</h2>
            <p class="text-on-surface-variant leading-relaxed">
                ASP.NET MVC 5 with C#, and AngularJS with Materialize CSS and SweetAlert2.
            </p>

        </div>
    </div>
</div>
