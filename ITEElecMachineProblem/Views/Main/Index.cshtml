@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="dot-grid py-16 px-4 md:px-8 relative overflow-hidden" ng-init="GetWelcomeMessage()">

    <!-- Decorative background -->
    <div class="absolute -top-10 -left-10 w-48 h-48 rounded-full bg-secondary-container/30 blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-64 h-64 rounded-full bg-primary-fixed-dim/20 blur-3xl pointer-events-none"></div>

    <div class="max-w-5xl mx-auto relative z-10 text-center">
        <span class="inline-block px-4 py-1.5 rounded-full bg-primary text-on-primary text-[10px] font-bold tracking-[0.2em] uppercase">Employee Management System</span>

        <h1 class="text-5xl md:text-6xl font-headline font-extrabold text-primary tracking-tighter leading-tight mt-6">
            Welcome to <br><span class="text-secondary italic">EMS Portal</span>
        </h1>

        <p class="text-on-surface-variant mt-5 max-w-xl mx-auto">
            Register employees, keep their records organized, and manage your workforce in one connected system.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">
            <a class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-primary to-primary-container text-on-primary font-headline font-bold rounded-full shadow-lg shadow-primary/20 hover:shadow-xl hover:opacity-90 transition-all cursor-pointer flex items-center justify-center gap-2" ng-click="redirectFunc('/Main/RegistrationPage')">
                <span>Register Employee</span>
                <span class="material-symbols-outlined text-xl">arrow_forward</span>
            </a>
            <a class="w-full sm:w-auto px-8 py-4 bg-transparent text-primary font-headline font-bold rounded-full border-2 border-dashed border-primary/40 hover:bg-primary/5 transition-all cursor-pointer" ng-click="redirectFunc('/Main/ContactPage')">
                Contact Us
            </a>
        </div>

        <!-- Feature cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-16 text-left">
            <div class="group p-6 rounded-2xl bg-surface-container-lowest border-2 border-dashed border-outline-variant/30 hover:border-secondary transition-colors">
                <div class="w-12 h-12 rounded-xl bg-tertiary-fixed flex items-center justify-center text-on-tertiary-fixed-variant group-hover:-rotate-6 transition-transform">
                    <span class="material-symbols-outlined">person_add</span>
                </div>
                <h3 class="font-headline font-bold text-on-surface mt-4">Register Employees</h3>
                <p class="text-on-surface-variant text-sm mt-1">Add new employee records with validated, complete details.</p>
            </div>

            <div class="group p-6 rounded-2xl bg-surface-container-lowest border-2 border-dashed border-outline-variant/30 hover:border-secondary transition-colors">
                <div class="w-12 h-12 rounded-xl bg-primary-fixed flex items-center justify-center text-on-primary-fixed-variant group-hover:rotate-3 transition-transform">
                    <span class="material-symbols-outlined">table_view</span>
                </div>
                <h3 class="font-headline font-bold text-on-surface mt-4">View Records</h3>
                <p class="text-on-surface-variant text-sm mt-1">See every employee in a live table that updates instantly.</p>
            </div>

            <div class="group p-6 rounded-2xl bg-surface-container-lowest border-2 border-dashed border-outline-variant/30 hover:border-secondary transition-colors">
                <div class="w-12 h-12 rounded-xl bg-tertiary-fixed-dim flex items-center justify-center text-on-tertiary-fixed-variant group-hover:-rotate-3 transition-transform">
                    <span class="material-symbols-outlined">edit_note</span>
                </div>
                <h3 class="font-headline font-bold text-on-surface mt-4">Update or Remove</h3>
                <p class="text-on-surface-variant text-sm mt-1">Edit existing records or delete them with a confirmation.</p>
            </div>
        </div>
    </div>
</div>
